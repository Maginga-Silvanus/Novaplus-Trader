rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function adminRoleIs(roles) {
      return request.auth != null
        && request.auth.token.adminRole in roles;
    }

    function canReadAllAdminData() {
      return adminRoleIs(['SUPER_ADMIN', 'ADMIN', 'READ_ONLY']);
    }

    function canReadOperationsData() {
      return adminRoleIs(['SUPER_ADMIN', 'ADMIN', 'OPERATIONS', 'READ_ONLY']);
    }

    function canReadSupportData() {
      return adminRoleIs(['SUPER_ADMIN', 'ADMIN', 'SUPPORT', 'READ_ONLY']);
    }

    function canReadComplianceData() {
      return adminRoleIs(['SUPER_ADMIN', 'ADMIN', 'COMPLIANCE', 'READ_ONLY']);
    }

    function validUserProfile(userId) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'fullName',
          'displayName',
          'phoneNumber',
          'photoUrl',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == userId;
    }

    function validNotification(userId) {
      return request.resource.data.keys().hasOnly([
          'userId',
          'title',
          'body',
          'category',
          'timestamp',
          'isRead',
          'deepLink',
          'priority',
          'metadata',
          'createdAt'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.category in [
          'WALLET', 'TRADING', 'BOT', 'SECURITY', 'SYSTEM', 'BETTING', 'CASINO_DEMO'
        ]
        && request.resource.data.isRead is bool
        && request.resource.data.createdAt == request.time;
    }

    function validNotificationPreferences() {
      return request.resource.data.keys().hasOnly([
          'allowTransactions',
          'allowTrading',
          'allowTradingBot',
          'allowSecurity',
          'allowSystem',
          'allowDemoGames'
        ])
        && request.resource.data.allowTransactions is bool
        && request.resource.data.allowTrading is bool
        && request.resource.data.allowTradingBot is bool
        && request.resource.data.allowSecurity is bool
        && request.resource.data.allowSystem is bool
        && request.resource.data.allowDemoGames is bool;
    }

    function validBotSettings() {
      return request.resource.data.keys().hasOnly([
          'strategy',
          'timeframe',
          'indicators',
          'riskLimitBps',
          'tradeSizeMinorUnits',
          'stopLossBps',
          'takeProfitBps',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'strategy',
          'timeframe',
          'indicators',
          'riskLimitBps',
          'tradeSizeMinorUnits',
          'stopLossBps',
          'takeProfitBps',
          'updatedAt'
        ])
        && request.resource.data.strategy in ['trend-following', 'range-grid', 'momentum']
        && request.resource.data.timeframe in ['1m', '5m', '15m', '1h', '4h', '1d']
        && request.resource.data.indicators is list
        && request.resource.data.indicators.size() <= 10
        && request.resource.data.indicators.hasOnly(['sma', 'ema', 'rsi', 'macd', 'bollinger'])
        && request.resource.data.riskLimitBps is int
        && request.resource.data.riskLimitBps >= 1
        && request.resource.data.riskLimitBps <= 10000
        && request.resource.data.tradeSizeMinorUnits is int
        && request.resource.data.tradeSizeMinorUnits > 0
        && request.resource.data.tradeSizeMinorUnits <= 100000000
        && request.resource.data.stopLossBps is int
        && request.resource.data.stopLossBps >= 0
        && request.resource.data.stopLossBps <= 10000
        && request.resource.data.takeProfitBps is int
        && request.resource.data.takeProfitBps >= 0
        && request.resource.data.takeProfitBps <= 10000
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if signedInAs(userId) || canReadAllAdminData();
      allow list: if canReadAllAdminData();
      allow create, update: if signedInAs(userId) && validUserProfile(userId);
      allow delete: if false;
    }

    match /users/{userId}/wallets/main {
      allow get, list: if signedInAs(userId) || canReadOperationsData();
      allow create, update, delete: if false;

      match /transactions/{transactionId} {
        allow get, list: if signedInAs(userId) || canReadOperationsData();
        allow create, update, delete: if false;
      }
    }

    match /users/{userId}/cryptoWallets/spot {
      allow get, list: if signedInAs(userId) || canReadOperationsData();
      allow create, update, delete: if false;

      match /holdings/{assetId} {
        allow get, list: if signedInAs(userId) || canReadOperationsData();
        allow create, update, delete: if false;
      }

      match /transactions/{transactionId} {
        allow get, list: if signedInAs(userId) || canReadOperationsData();
        allow create, update, delete: if false;
      }
    }

    match /users/{userId}/tradeRequests/{requestId} {
      allow get, list: if signedInAs(userId) || canReadOperationsData();
      allow create, update, delete: if false;
    }

    match /users/{userId}/financialRequests/{requestId} {
      allow get, list: if signedInAs(userId) || canReadOperationsData();
      allow create, update, delete: if false;
    }

    match /users/{userId}/walletOperations/{operationId} {
      allow get, list: if signedInAs(userId) || canReadOperationsData();
      allow create, update, delete: if false;
    }

    match /users/{userId}/notifications/{notificationId} {
      allow get, list: if signedInAs(userId);
      allow create, update: if signedInAs(userId) && validNotification(userId);
      allow delete: if signedInAs(userId);
    }

    match /users/{userId}/settings/notifications {
      allow get: if signedInAs(userId);
      allow create, update: if signedInAs(userId) && validNotificationPreferences();
      allow delete: if false;
    }

    match /users/{userId}/supportTickets/{ticketId} {
      allow get, list: if signedInAs(userId) || canReadSupportData();
      allow create: if signedInAs(userId)
        && request.resource.data.keys().hasOnly([
          'userId', 'subject', 'category', 'status', 'latestResponse',
          'transactionId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.subject is string
        && request.resource.data.category in [
          'ACCOUNT', 'WALLET', 'DEPOSIT', 'WITHDRAWAL', 'TRADING',
          'BOT', 'SECURITY', 'TECHNICAL_ISSUE', 'OTHER'
        ]
        && request.resource.data.status == 'OPEN'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedInAs(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['latestResponse', 'status', 'updatedAt'])
        && request.resource.data.status == 'OPEN'
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if signedInAs(userId) || canReadSupportData();
        allow create: if signedInAs(userId)
          && request.resource.data.keys().hasOnly([
            'senderType', 'senderName', 'messageText', 'createdAt'
          ])
          && request.resource.data.senderType == 'USER'
          && request.resource.data.messageText is string
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /users/{userId}/botSettings/{settingId} {
      allow get, list: if signedInAs(userId) || canReadOperationsData();
      allow create, update: if signedInAs(userId) && validBotSettings();
      allow delete: if signedInAs(userId);
    }

    match /{path=**}/wallets/{walletId} {
      allow get, list: if canReadOperationsData() && walletId == 'main';
      allow write: if false;
    }

    match /{path=**}/transactions/{transactionId} {
      allow get, list: if canReadOperationsData();
      allow write: if false;
    }

    match /{path=**}/tradeRequests/{requestId} {
      allow get, list: if canReadOperationsData();
      allow write: if false;
    }

    match /users/{userId}/kycSubmissions/{submissionId} {
      allow get, list: if signedInAs(userId) || canReadComplianceData();
      allow write: if false;
    }

    match /users/{userId}/kycSubmissions/{submissionId}/{document=**} {
      allow read: if signedInAs(userId) || canReadComplianceData();
      allow write: if false;
    }

    match /users/{userId}/botCommands/{commandId} {
      allow get, list: if signedInAs(userId) || canReadOperationsData();
      allow write: if false;
    }

    match /systemHealth/{docId} {
      allow get, list: if canReadAllAdminData();
      allow write: if false;
    }

    match /systemIncidents/{docId} {
      allow get, list: if canReadAllAdminData();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
