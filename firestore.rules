rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & ACCESS CONTROL
    // =========================================================================

    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (request.auth.token.role in [
          'SUPER_ADMIN', 'ADMIN', 'OPERATIONS',
          'COMPLIANCE', 'SUPPORT', 'READ_ONLY'
        ]) ||
        exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid))
      );
    }

    function hasAdminRole(role) {
      return request.auth != null && (
        request.auth.token.role == role ||
        (
          exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.role == role
        )
      );
    }

    function validBotSettings() {
      return request.resource.data.keys().hasOnly([
          'strategy',
          'timeframe',
          'indicators',
          'riskLimitBps',
          'tradeSizeMinorUnits',
          'stopLossBps',
          'takeProfitBps',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'strategy',
          'timeframe',
          'indicators',
          'riskLimitBps',
          'tradeSizeMinorUnits',
          'stopLossBps',
          'takeProfitBps',
          'updatedAt'
        ])
        && request.resource.data.strategy in ['trend-following', 'range-grid', 'momentum']
        && request.resource.data.timeframe in ['1m', '5m', '15m', '1h', '4h', '1d']
        && request.resource.data.indicators is list
        && request.resource.data.indicators.size() <= 10
        && request.resource.data.indicators.hasOnly(['sma', 'ema', 'rsi', 'macd', 'bollinger'])
        && request.resource.data.riskLimitBps is int
        && request.resource.data.riskLimitBps >= 1
        && request.resource.data.riskLimitBps <= 10000
        && request.resource.data.tradeSizeMinorUnits is int
        && request.resource.data.tradeSizeMinorUnits > 0
        && request.resource.data.tradeSizeMinorUnits <= 100000000
        && request.resource.data.stopLossBps is int
        && request.resource.data.stopLossBps >= 0
        && request.resource.data.stopLossBps <= 10000
        && request.resource.data.takeProfitBps is int
        && request.resource.data.takeProfitBps >= 0
        && request.resource.data.takeProfitBps <= 10000
        && request.resource.data.updatedAt == request.time;
    }

    function validFinancialRequest() {
      return request.resource.data.keys().hasAll([
          'idempotencyKey',
          'userId',
          'walletId',
          'type',
          'amountMinorUnits',
          'currency',
          'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['DEPOSIT', 'WITHDRAWAL', 'TRANSFER']
        && request.resource.data.amountMinorUnits is int
        && request.resource.data.amountMinorUnits > 0
        && request.resource.data.currency in ['USD', 'KES', 'EUR']
        && request.resource.data.idempotencyKey is string
        && request.resource.data.idempotencyKey.size() >= 10;
    }

    function validNotification(userId) {
      return request.resource.data.keys().hasAll([
          'userId', 'title', 'body', 'category', 'timestamp', 'isRead', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'userId', 'title', 'body', 'category', 'timestamp', 'isRead',
          'deepLink', 'priority', 'metadata', 'createdAt'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.category in [
          'WALLET', 'TRADING', 'BOT', 'SECURITY', 'SYSTEM', 'BETTING', 'CASINO_DEMO'
        ]
        && request.resource.data.isRead is bool
        && request.resource.data.createdAt == request.time;
    }

    function validNotificationPreferences() {
      return request.resource.data.keys().hasAll([
          'allowTransactions',
          'allowTrading',
          'allowTradingBot',
          'allowSecurity',
          'allowSystem',
          'allowDemoGames'
        ])
        && request.resource.data.keys().hasOnly([
          'allowTransactions',
          'allowTrading',
          'allowTradingBot',
          'allowSecurity',
          'allowSystem',
          'allowDemoGames'
        ])
        && request.resource.data.allowTransactions is bool
        && request.resource.data.allowTrading is bool
        && request.resource.data.allowTradingBot is bool
        && request.resource.data.allowSecurity is bool
        && request.resource.data.allowSystem is bool
        && request.resource.data.allowDemoGames is bool;
    }

    // =========================================================================
    // USER PROFILES
    // =========================================================================

    match /users/{userId} {
      allow get, list: if signedInAs(userId) || isAdmin();
      allow create, update: if signedInAs(userId);
      allow delete: if false;
    }

    // =========================================================================
    // AUTHORITATIVE WALLETS, TRANSACTIONS & DOUBLE-ENTRY LEDGER
    // =========================================================================

    match /wallets/{walletId} {
      allow get, list: if
        (request.auth != null && resource.data.userId == request.auth.uid) ||
        isAdmin();

      // Wallet state can only be changed by trusted backend code.
      allow create, update, delete: if false;

      match /transactions/{transactionId} {
        allow get, list: if
          (request.auth != null &&
            get(/databases/$(database)/documents/wallets/$(walletId)).data.userId == request.auth.uid) ||
          isAdmin();
        allow create, update, delete: if false;
      }

      match /ledger/{ledgerEntryId} {
        allow get, list: if
          (request.auth != null &&
            get(/databases/$(database)/documents/wallets/$(walletId)).data.userId == request.auth.uid) ||
          isAdmin();
        allow create, update, delete: if false;
      }
    }

    // Legacy user wallet sub-collections (read-only for users)
    match /users/{userId}/wallets/{walletId} {
      allow get, list: if signedInAs(userId) || isAdmin();
      allow create, update, delete: if false;

      match /transactions/{transactionId} {
        allow get, list: if signedInAs(userId) || isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /users/{userId}/cryptoWallets/spot {
      allow get, list: if signedInAs(userId) || isAdmin();
      allow create, update, delete: if false;

      match /holdings/{assetId} {
        allow get, list: if signedInAs(userId) || isAdmin();
        allow create, update, delete: if false;
      }

      match /transactions/{transactionId} {
        allow get, list: if signedInAs(userId) || isAdmin();
        allow create, update, delete: if false;
      }
    }

    // =========================================================================
    // USER NOTIFICATIONS & SETTINGS
    // =========================================================================

    match /users/{userId}/notifications/{notificationId} {
      allow get, list: if signedInAs(userId) || isAdmin();
      allow create: if signedInAs(userId) && validNotification(userId);

      // Allow valid notification saves and read-status changes.
      allow update: if signedInAs(userId) && (
        validNotification(userId) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
          request.resource.data.isRead is bool
        )
      );

      allow delete: if signedInAs(userId);
    }

    match /users/{userId}/settings/notifications {
      allow get: if signedInAs(userId) || isAdmin();
      allow create, update: if
        signedInAs(userId) && validNotificationPreferences();
      allow delete: if false;
    }

    // =========================================================================
    // USER SUPPORT TICKETS
    // =========================================================================

    match /users/{userId}/supportTickets/{ticketId} {
      allow get, list: if signedInAs(userId) || isAdmin();

      allow create: if signedInAs(userId)
        && request.resource.data.keys().hasAll([
          'userId', 'subject', 'category', 'status', 'latestResponse',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'userId', 'subject', 'category', 'status', 'latestResponse',
          'transactionId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.subject is string
        && request.resource.data.category in [
          'ACCOUNT', 'WALLET', 'DEPOSIT', 'WITHDRAWAL', 'TRADING',
          'BOT', 'SECURITY', 'TECHNICAL_ISSUE', 'OTHER'
        ]
        && request.resource.data.status == 'OPEN'
        && request.resource.data.latestResponse is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedInAs(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['latestResponse', 'status', 'updatedAt'])
        && request.resource.data.latestResponse is string
        && request.resource.data.status == 'OPEN'
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if signedInAs(userId) || isAdmin();

        allow create: if signedInAs(userId)
          && request.resource.data.keys().hasAll([
            'senderType', 'senderName', 'messageText', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'senderType', 'senderName', 'messageText', 'createdAt'
          ])
          && request.resource.data.senderType == 'USER'
          && request.resource.data.senderName is string
          && request.resource.data.messageText is string
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    // =========================================================================
    // CLIENT FINANCIAL & TRADE REQUESTS
    // =========================================================================

    match /users/{userId}/financialRequests/{requestId} {
      allow get, list: if signedInAs(userId) || isAdmin();
      allow create: if signedInAs(userId) && validFinancialRequest();
      allow update, delete: if false;
    }

    match /users/{userId}/tradeRequests/{requestId} {
      allow get, list: if signedInAs(userId) || isAdmin();
      allow create: if signedInAs(userId);
      allow update, delete: if false;
    }

    match /users/{userId}/walletOperations/{operationId} {
      allow get, list: if signedInAs(userId) || isAdmin();
      allow create: if signedInAs(userId) || isAdmin();
      allow update, delete: if false;
    }

    // =========================================================================
    // TRADING BOTS & COMMANDS
    // =========================================================================

    match /users/{userId}/botSettings/{settingId} {
      allow get, list: if signedInAs(userId) || isAdmin();
      allow create, update: if signedInAs(userId) && validBotSettings();
      allow delete: if signedInAs(userId);
    }

    match /users/{userId}/botCommands/{commandId} {
      allow get, list: if signedInAs(userId) || isAdmin();
      allow create: if
        signedInAs(userId) ||
        hasAdminRole('OPERATIONS') ||
        hasAdminRole('SUPER_ADMIN');
      allow update, delete: if false;
    }

    // =========================================================================
    // ADMIN CONTROL CENTER & OPERATIONAL COLLECTIONS
    // =========================================================================

    match /adminRoles/{userId} {
      allow get: if signedInAs(userId) || isAdmin();
      allow list, create, update, delete: if false;
    }

    match /adminMetrics/{docId} {
      allow get, list: if isAdmin();
      allow write: if false;
    }

    match /adminAuditLogs/{auditId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /notificationRequests/{requestId} {
      allow get, list: if isAdmin();
      allow create: if
        hasAdminRole('SUPER_ADMIN') ||
        hasAdminRole('ADMIN') ||
        hasAdminRole('OPERATIONS');
      allow update, delete: if false;
    }

    // Top-level operational support tickets
    match /supportTickets/{ticketId} {
      allow get, list: if
        (request.auth != null && resource.data.userId == request.auth.uid) ||
        isAdmin();

      allow create: if
        request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      allow update: if
        (request.auth != null && resource.data.userId == request.auth.uid) ||
        isAdmin();

      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if (
          request.auth != null &&
          get(/databases/$(database)/documents/supportTickets/$(ticketId))
            .data.userId == request.auth.uid &&
          resource.data.isInternalNote == false
        ) || isAdmin();

        allow create: if (
          request.auth != null &&
          get(/databases/$(database)/documents/supportTickets/$(ticketId))
            .data.userId == request.auth.uid &&
          request.resource.data.isInternalNote == false
        ) || isAdmin();

        allow update, delete: if false;
      }
    }

    // =========================================================================
    // SYSTEM MONITORING & HEALTH
    // =========================================================================

    match /systemHealth/{docId} {
      allow get, list: if request.auth != null;
      allow write: if false;
    }

    match /systemIncidents/{docId} {
      allow get, list: if request.auth != null;
      allow write: if false;
    }

    // =========================================================================
    // FALLBACK: DENY UNMATCHED PATHS
    // =========================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
